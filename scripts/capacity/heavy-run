#!/usr/bin/env bash
# heavy-run: executa um job da fila heavy. Chamado pelo tsp, não à mão.
# Roda o comando num serviço transitório do systemd (teto de CPU, memória e
# tempo), mede CPU e pico de memória e grava uma linha em jobs.jsonl.
set -uo pipefail

jdir=$1
HEAVY_LOG=${HEAVY_LOG:-/var/log/heavy}
# shellcheck source=/dev/null
. "$jdir/meta"
cwd=$(cat "$jdir/cwd")
cmd=$(cat "$jdir/cmd")
start=$(date +%s)
unit="heavy-$(basename "$jdir")"
summary="$jdir/summary"

echo "heavy: começou $(date -u +%T) UTC | $label/$kind | CPU ${cpu}% · RAM $mem · até ${tmin} min" >&2

RUNNING=${HEAVY_HOME:-/var/lib/heavy}/running
cg="/sys/fs/cgroup/system.slice/$unit.service"
printf 'unit=%s\nlabel=%q\nkind=%s\nstart=%s\ntmin=%s\npausable=%s\n' "$unit" "$label" "$kind" "$start" "$tmin" "${pausable:-0}" > "$RUNNING.$unit"
# "running" aponta para o job da fila; urgente rodando por fora não sobrescreve.
[ "${HEAVY_URGENT:-0}" = 1 ] || ln -sfn "$RUNNING.$unit" "$RUNNING"

# Vigia do job, fora do serviço (nunca é congelado junto):
#  - pico de RAM: o "Memory peak" do resumo do systemd vem errado em serviço
#    transitório; o kernel mantém memory.peak vivo enquanto o job roda.
#  - tempo máximo: conta só o tempo ativo. Job pausado para um urgente não
#    pode morrer por timeout ao ser retomado.
( active=0; while :; do
    if [ -d "$cg" ]; then
      cat "$cg/memory.peak" > "$jdir/peak" 2>/dev/null
      [ "$(cat "$cg/cgroup.freeze" 2>/dev/null)" = 1 ] || active=$((active + 1))
      echo "$active" > "$jdir/active"
      if [ "$active" -gt $((tmin * 60)) ] && [ ! -f "$jdir/timeout" ]; then
        touch "$jdir/timeout"; systemctl kill "$unit.service" 2>/dev/null
        ( sleep 30; systemctl kill -s KILL "$unit.service" 2>/dev/null ) &
      fi
    elif [ -f "$jdir/peak" ]; then break; fi
    sleep 1
  done ) &
sampler=$!

# O resumo do systemd-run (resultado, CPU, pico de memória) sai no stderr junto
# com o do comando; o tee guarda uma cópia para extrair os números.
systemd-run --wait --pipe --collect --unit="$unit" \
  -p CPUQuota="${cpu}%" -p MemoryMax="$mem" -p MemorySwapMax=0 \
  -p RuntimeMaxSec="$((tmin * 60 * 4))" -p Nice=10 -p IOSchedulingClass=idle \
  --working-directory="$cwd" \
  bash -c 'set -a; . "$1"; set +a; rm -f "$1"; eval "exec $2"' heavy "$jdir/env" "$cmd" \
  2> >(tee "$summary" | grep --line-buffered -vE '^(Running as unit|Finished with result|Main processes terminated|Service runtime|CPU time consumed|Memory (swap )?peak)' >&2)
rc=$?
end=$(date +%s)
kill "$sampler" 2>/dev/null; wait "$sampler" 2>/dev/null
rm -f "$jdir/env" "$RUNNING.$unit"
[ "$(readlink "$RUNNING" 2>/dev/null)" = "$RUNNING.$unit" ] && rm -f "$RUNNING"

field() { grep -m1 "^$1:" "$summary" 2>/dev/null | cut -d: -f2- | sed 's/^ *//'; }
to_ms() { # "1min 2.5s", "345ms", "2.1s" -> ms
  awk '{ t=0; for (i=1;i<=NF;i++) { v=$i
    if (v ~ /ms$/) { sub("ms","",v); t+=v }
    else if (v ~ /min$/) { sub("min","",v); t+=v*60000 }
    else if (v ~ /h$/) { sub("h","",v); t+=v*3600000 }
    else if (v ~ /s$/) { sub("s","",v); t+=v*1000 } }
    printf "%d", t }'
}
result=$(field "Finished with result")
# Morto pelo vigia do job: rc 124, como o timeout(1), para quem chamou não achar que passou.
[ -f "$jdir/timeout" ] && { result=timeout; rc=124; }
cpu_ms=$(field "CPU time consumed" | to_ms)
mem_mb=$(( $(cat "$jdir/peak" 2>/dev/null || echo 0) / 1048576 ))
# Morto por memória antes da 1ª amostra: o pico foi o próprio teto.
[ "$result" = oom-kill ] && [ "$mem_mb" -eq 0 ] && mem_mb=$(numfmt --from=iec "$mem" 2>/dev/null | awk '{printf "%d", $1/1048576}')
echo "heavy: fim $(date -u +%T) UTC | ${result:-?} rc=$rc | $((end - start)) s | CPU ${cpu_ms:-0} ms | RAM pico ${mem_mb:-0} MB" >&2
[ "$result" = timeout ] && echo "heavy: estourou ${tmin} min e foi morto" >&2
[ "$result" = oom-kill ] && echo "heavy: estourou a memória ($mem) e foi morto" >&2

# Rastro: uma linha por job. O comando vai cortado para não carregar segredo.
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n' | cut -c1-160; }
printf '{"inicio":%d,"fim":%d,"espera_s":%d,"duracao_s":%d,"projeto":"%s","tipo":"%s","cpu_ms":%s,"cpu_media_pct":%s,"ram_pico_mb":%s,"teto_cpu_pct":%s,"teto_ram":"%s","resultado":"%s","rc":%d,"origem":"%s","pasta":"%s","comando":"%s"}\n' \
  "$start" "$end" "$((start - enqueued))" "$((end - start))" "$(esc "$label")" "$kind" \
  "${cpu_ms:-0}" "$(( ${cpu_ms:-0} / 10 / ( (end - start) > 0 ? (end - start) : 1 ) ))" "${mem_mb:-0}" \
  "$cpu" "$mem" "${result:-desconhecido}" "$rc" "$(esc "$caller")" "$(esc "$cwd")" "$(esc "$cmd")" \
  >> "$HEAVY_LOG/jobs.jsonl"

rm -rf "$jdir"
exit "$rc"
