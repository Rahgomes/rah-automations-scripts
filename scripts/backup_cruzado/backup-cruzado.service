[Unit]
Description=Backup cruzado srv986128 -> Contabo (config cifrada + espelho do MinIO), via fila heavy
After=network-online.target wg-quick@wg0.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/heavy -l backup-cruzado -k manutencao -c 50 -m 512M -t 240 -- /usr/local/lib/backup-cruzado/envio-srv986128.sh
